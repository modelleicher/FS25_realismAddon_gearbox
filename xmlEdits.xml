    <!-- small Trac Series has a weird transmission IRL since its basically a unimog -->
    <!-- in high range 4. gear is blocked otherwise it would go to 78kph -->
    <!-- 3rd gear is speed limited electronically (rpm limit on pump) otherwise it would go 50kph, so it does 40kph at reduced engine rpm in high range -->
    <!-- second group is air activated splitter shifter that works as preselect (shift and as soon as you hit the clutch it shifts)-->
