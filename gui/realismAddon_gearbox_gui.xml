<?xml version="1.0" encoding="utf-8" standalone="no" ?>


<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
	<GuiElement profile="newLayer" />
	<Bitmap profile="dialogFullscreenBg"/>

    <GuiElement profile="fs25_dialogContentContainer" id="settingsContainer">

        <BoxLayout profile="fs25_dialogButtonBox" position="0px -40px">
            <Button profile="buttonBack" id="noButton" text="$l10n_button_back" onClick="onClickBack"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>

            <Button profile="buttonOK" id="yesButton" text="$l10n_button_ok" onClick="onClickOk"/>
            <Bitmap profile="fs25_dialogButtonBoxSeparator"/>
        </BoxLayout>

        <Bitmap profile="fs25_settingsTooltipSeparator" position="860px -50px" height="680px" />

        <!--BoxLayout position="600px -50px"-->

            <GuiElement profile="fs25_multiTextOptionContainer" position="15px -50px">
                <Text profile="multiTextOptionSettingsTitle" id="ragb_test_1_text" text="Clutch Auto Open"/>
                <BinaryOption profile="fs25_settingsBinaryOption" id="ragb_keyboardClutch_autoOpen" >
                    <Text profile="fs25_multiTextOptionTooltip" name="ignore" id="ragb_test_1_text2" position="700px 0px"/>
                </BinaryOption>	
            </GuiElement>    

            <GuiElement profile="fs25_multiTextOptionContainer" position="15px -100px">
                <Text profile="multiTextOptionSettingsTitle" id="ragb_test_1_text" text="Clutch Auto Movement"/>
                <BinaryOption profile="fs25_settingsBinaryOption" id="ragb_keyboardClutch_autoMovement" >
                    <Text profile="fs25_multiTextOptionTooltip" name="ignore" id="ragb_test_1_text2" position="700px 0px"/>
                </BinaryOption>	
            </GuiElement>                 


        <!--/BoxLayout-->


    </GuiElement>     

</GUI>