<?xml version="1.0" encoding="utf-8" standalone="no" ?>




<!-- XML Examples -->


<!-- Vario 1. Gen CVT (first gen 900 Vario complete manual control vario transmission inkl. joystick simulation)-->
<!-- this example is for a 900 Vario, but it can theoretically als be used for the 1. gen 700 and 400 vario -->
<!-- the 2 forwardGears are now the 2 ranges field and road or I and II, gearChangeTime is 0 since those ranges can be shifted without clutch-->
<!-- in theory the ranges can be shifted even under load but thats not good for the transmission, ideally when standing still or no load. ideally in neutral -->
<!-- but this way, having them as powershift is realistic -->
<transmission autoGearChangeTime="0" gearChangeTime="0" name="$l10n_info_transmission_manual">
    <forwardGear maxSpeed="30"/>
    <forwardGear maxSpeed="55"/>
    
    <!-- this is the setup for vario transmission, best not to change it -->
    <!-- as soon as isVario is set to true the script assumes a lot of settings specific for 1. gen vario transmissions -->
    <!-- in the future all optional cvt settings will be explained but some of them aren't fully implemented yet so, there is no further explanation, just copy this part-->
    <realismAddon_gearbox>
        <cvt minPercentage="0.01" maxPercentage="1" manualControl="true" canChangeDirection="true" isVario="true" />
    </realismAddon_gearbox>
    <!-- - - - - - - - - - - - - - - -->
</transmission>
				



<!-- Fluid Clutch (like Fendt Turbomatik) -->
<!-- This Example is a Fendt Gearbox like the Xylon or 500C -->
<transmission autoGearChangeTime="1" gearChangeTime="0.25" name="$l10n_info_transmission_manualWithPowerShiftGroups" startGearThreshold="0.75">
    <directionChange useGear="false" useGroup="false" changeTime="0.25"/>

    <groups type="POWERSHIFT" changeTime="0.25">
        <group ratio="0.5356" name="I"/>
        <group ratio="0.6907" name="II"/>
        <group ratio="0.8458" name="III"/>
        <group ratio="1.0000" name="IV" isDefault="true"/>
    </groups>

    <forwardGear maxSpeed="5.71"/>
    <forwardGear maxSpeed="9.39"/>
    <forwardGear maxSpeed="14.03"/>
    <forwardGear maxSpeed="21.87"/>
    <forwardGear maxSpeed="32.10"/>
    <forwardGear maxSpeed="53.00"/>

    <!-- this part needs to be added -->
    <realismAddon_gearbox> 
        <!-- fluidClutch line: stallRpm = rpm where the fluid clutch is mechanically connected, idleBiasFx = factor for how much torque is transmitted at idle, default 1, higher means more torque -->
        <fluidClutch stallRpm="1350" idleBiasFx="1"/>
    </realismAddon_gearbox>  
     <!-- - - - - - - - - - - - - - - -->      
</transmission>


<!-- CVT in combination with gears for example for combines -->
<!-- the CVT feature is mainly for the use in older combines who combine gears and belt variators -->
<!-- it currently lacks the ability to stop the vehicle using the cvt alone so its not suited for hydrostatic transmissions -->
<!-- this example is for a Claas Matador Gigant -->
<transmission autoGearChangeTime="1.0" gearChangeTime="0.7" name="$l10n_info_transmission_manual">
    <directionChange useGear="true" changeTime="0.8"/>
    <backwardGear maxSpeed="7.9" name="R"/>
    <forwardGear maxSpeed="4.63"/>
    <forwardGear maxSpeed="7.9"/>
    <forwardGear maxSpeed="20.5"/>
    
    <!-- this part needs to be added -->
    <realismAddon_gearbox> 
        <!--cvt line: minPercentage = min cvt ratio value, maxPercentage = max cvt ratio value, manualControl = cvt is manually controlled via inputs (currently only option)-->
        <cvt minPercentage="0.41" maxPercentage="1" manualControl="true" />
        <!--note: minPercentage should not be 0 currently the cvt can not stop the vehicle on its own -->
    </realismAddon_gearbox>
    <!-- - - - - - - - - - - - - - - -->
  
</transmission>
<!-- - - - - - - - - - - - - - - -->
<!-- - - - - - - - - - - - - - - -->


<!-- Second Group Set -->
<!-- The secong group set feature adds the ability to add a second set of groupgears -->
<!-- Many tractors IRL have more than just gears and groups. A lot of tractors have 2 sets of groups -->
<!-- For example Gears 1-4, Groupset1 with L, M, H, R and Groupset2 with High-Low powershift -->
<!-- or for example Gears 1-6, Groupset1 with 1,2,3,4 powershift ranges and Groupset2 with High and Low range -->
<!-- this example is a realistic config for the John Deere 3650 using the second group set for the powershift range -->
<transmission autoGearChangeTime="0.3" gearChangeTime="0.3" name="$l10n_info_transmission_manualWithPowerShiftGroups">
    <directionChange useGear="false" useGroup="true" changeTime="0.5"/>
    <groups type="DEFAULT" changeTime="0">
        <group name="R" ratio="-0.342"/>
        <group name="I" ratio="0.5"/>
        <group name="II" ratio="1.0"/>
    </groups>

    <forwardGear maxSpeed="11.4" name="1" reverseName="-1"/>
    <forwardGear maxSpeed="17.1" name="2" reverseName="-2"/>
    <forwardGear maxSpeed="26.4" name="3" reverseName="-3"/>
    <forwardGear maxSpeed="38.1" name="4" reverseName="-4"/>

    <!-- this part needs to be added -->
    <realismAddon_gearbox> 
        <!-- groupsSecondSet line: 
        powerShift = true/false if groups are powershiftable 
        preselect = true/false if this is true the group can be preselected but only changes once clutch is pressed
        liftToShift = true/false if this is true the group can be preselected and shifts once the throttle is lifted -->
        <groupsSecondSet powerShift="true" preselect="false" liftToShift="false">
            <!-- group line: there can be as many groups as you want 
            ratio = group speed ratio 
            name = name shown in hud 
            isDefault = true/false if this is set true this group is selected by default -->
            <group ratio="0.8162" name="L" />
            <group ratio="1.0" name="H" isDefault="true" />           
        </groupsSecondSet>
    </realismAddon_gearbox> 
    <!-- - - - - - - - - - - - - - - -->  

</transmission>

<!-- second group can also have gear lever animations -->
<!-- basically the same as for normal groups but with "secondGroup" instead of "group"-->
<gearLever node="leverGroupSecond" centerAxis="3" changeTime="0.2" handsOnDelay="0.2">
    <state secondGroup="1" xRot="-10" yRot="0" zRot="0"/>
    <state secondGroup="2" xRot="5" yRot="0" zRot="0"/>
    <state secondGroup="3" xRot="5" yRot="0" zRot="5"/>
</gearLever>


